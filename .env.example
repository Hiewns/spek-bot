# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
COMMAND_PREFIX=!

# TTS Backend: "edge" (free, keyless Microsoft voices), "capcut", or "http"
TTS_BACKEND=edge

# Edge-TTS Configuration (used when TTS_BACKEND=edge)
# Vietnamese voices: vi-VN-HoaiMyNeural (female), vi-VN-NamMinhNeural (male)
EDGE_VOICE=vi-VN-HoaiMyNeural
# EDGE_PROXY=http://127.0.0.1:7890
EDGE_RETRIES=3
EDGE_MAX_CONCURRENT=10
EDGE_VOLUME=+0%
EDGE_PITCH=+0Hz
# Create a file named edgetts-noproxy.txt to bypass the proxy entirely.

# CapCut TTS Configuration (used when TTS_BACKEND=capcut)
CAPCUT_VOICE=BV421_vivn_streaming
# CAPCUT_RESOURCE_ID=
# CAPCUT_DEVICE_JSON=capcut-tts-api-main/device.json
CAPCUT_TIMEOUT=90

# Custom HTTP TTS API Configuration (used when TTS_BACKEND=http)
TTS_API_URL=https://your-tts-api.com
TTS_API_KEY=your_api_key_here

DEFAULT_VOICE=vi-VN-HoaiMyNeural
DEFAULT_SPEED=1.0

# Rate Limiter & Message Limits
MAX_MESSAGE_LENGTH=500
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60

# Audio Caching
CACHE_DIR=./audio_cache
CACHE_TTL_HOURS=24
MAX_CACHE_SIZE_MB=500

# Logging
LOG_LEVEL=INFO
